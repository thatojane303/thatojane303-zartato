+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "@openzeppelin/contracts/access/Ownable.sol";
+import "@openzeppelin/contracts/security/Pausable.sol";
+
+contract ZarTATOOracle is Ownable, Pausable {
+    uint256 public latestPrice;      // price per unit (e.g. per potato or per kg)
+    uint256 public lastUpdated;      // timestamp of last update
+    uint256 public maxChangeBps;     // max allowed change in basis points (e.g. 500 = 5%)
+    uint256 public maxAgeSeconds;    // max allowed age before considered stale
+
+    event PriceUpdated(uint256 newPrice);
+
+    error MaxChangeExceeded();
+    error StalePrice();
+
+    constructor(
+        address owner_,
+        uint256 maxChangeBps_,
+        uint256 maxAgeSeconds_
+    ) {
+        require(owner_ != address(0), "owner zero");
+        _transferOwnership(owner_);
+        maxChangeBps = maxChangeBps_;
+        maxAgeSeconds = maxAgeSeconds_;
+    }
+
+    function updatePrice(uint256 newPrice) external onlyOwner whenNotPaused {
+        require(newPrice > 0, "price zero");
+
+        if (latestPrice != 0) {
+            uint256 diff = newPrice > latestPrice
+                ? newPrice - latestPrice
+                : latestPrice - newPrice;
+
+            uint256 diffBps = (diff * 10_000) / latestPrice;
+            if (diffBps > maxChangeBps) {
+                revert MaxChangeExceeded();
+            }
+        }
+
+        latestPrice = newPrice;
+        lastUpdated = block.timestamp;
+
+        emit PriceUpdated(newPrice);
+    }
+
+    function getLatestPrice() external view returns (uint256) {
+        return latestPrice;
+    }
+
+    function getLastUpdated() external view returns (uint256) {
+        return lastUpdated;
+    }
+
+    function isStale() public view returns (bool) {
+        if (lastUpdated == 0) return true;
+        return block.timestamp - lastUpdated > maxAgeSeconds;
+    }
+
+    function requireFresh() public view {
+        if (isStale()) {
+            revert StalePrice();
+        }
+    }
+
+    function pause() external onlyOwner {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+}
