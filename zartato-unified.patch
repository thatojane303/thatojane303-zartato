+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import "@openzeppelin/contracts/access/Ownable.sol";
+import "@openzeppelin/contracts/security/Pausable.sol";
+
+interface IZarTATOOracle {
+    function getLatestPrice() external view returns (uint256);
+    function isStale() external view returns (bool);
+}
+
+contract ZarTATO is ERC20, Ownable, Pausable {
+    IZarTATOOracle public oracle;
+
+    bool public transfersRestricted;
+    string public underlyingCommodity; // e.g. "South African potatoes"
+    string public marketRegion;        // e.g. "ZA"
+
+    event Mint(address indexed to, uint256 amount);
+    event Burn(address indexed from, uint256 amount);
+    event TransfersRestricted(bool restricted);
+
+    error TransfersBlocked();
+    error OracleStale();
+
+    constructor(
+        address oracleAddress,
+        string memory name_,
+        string memory symbol_,
+        string memory underlyingCommodity_,
+        string memory marketRegion_
+    ) ERC20(name_, symbol_) {
+        require(oracleAddress != address(0), "oracle zero");
+        oracle = IZarTATOOracle(oracleAddress);
+        underlyingCommodity = underlyingCommodity_;
+        marketRegion = marketRegion_;
+    }
+
+    function _beforeTokenTransfer(
+        address from,
+        address to,
+        uint256 amount
+    ) internal override {
+        super._beforeTokenTransfer(from, to, amount);
+
+        if (paused()) {
+            revert("Pausable: paused");
+        }
+
+        if (transfersRestricted && from != address(0)) {
+            revert TransfersBlocked();
+        }
+    }
+
+    function mint(address to, uint256 amount) external onlyOwner {
+        _mint(to, amount);
+        emit Mint(to, amount);
+    }
+
+    function burn(uint256 amount) external {
+        _burn(_msgSender(), amount);
+        emit Burn(_msgSender(), amount);
+    }
+
+    function latestPrice() public view returns (uint256) {
+        if (oracle.isStale()) {
+            revert OracleStale();
+        }
+        return oracle.getLatestPrice();
+    }
+
+    function valuation(uint256 amount) external view returns (uint256) {
+        uint256 price = latestPrice();
+        return amount * price;
+    }
+
+    function setTransfersRestricted(bool restricted) external onlyOwner {
+        transfersRestricted = restricted;
+        emit TransfersRestricted(restricted);
+    }
+
+    function setOracle(address newOracle) external onlyOwner {
+        require(newOracle != address(0), "oracle zero");
+        oracle = IZarTATOOracle(newOracle);
+    }
+
+    function pause() external onlyOwner {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+}
