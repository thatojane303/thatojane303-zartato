@@ -0,0 +1,88 @@
+const { expect } = require("chai");
+const { ethers } = require("hardhat");
+
+describe("ZarTATOOracle", () => {
+  let owner, user;
+  let oracle;
+
+  beforeEach(async () => {
+    [owner, user] = await ethers.getSigners();
+
+    const Oracle = await ethers.getContractFactory("ZarTATOOracle");
+    oracle = await Oracle.deploy(owner.address, 500, 3600);
+    await oracle.waitForDeployment();
+  });
+
+  it("initially has no price and is stale", async () => {
+    expect(await oracle.getLatestPrice()).to.equal(0);
+    expect(await oracle.isStale()).to.equal(true);
+  });
+
+  it("owner can update price and emits event", async () => {
+    await expect(oracle.connect(owner).updatePrice(1000))
+      .to.emit(oracle, "PriceUpdated")
+      .withArgs(1000);
+
+    expect(await oracle.getLatestPrice()).to.equal(1000);
+    expect(await oracle.getLastUpdated()).to.be.gt(0);
+    expect(await oracle.isStale()).to.equal(false);
+  });
+
+  it("non-owner cannot update price", async () => {
+    await expect(
+      oracle.connect(user).updatePrice(1000)
+    ).to.be.revertedWith("Ownable: caller is not the owner");
+  });
+
+  it("reverts on excessive price change", async () => {
+    await oracle.connect(owner).updatePrice(1000);
+
+    await expect(
+      oracle.connect(owner).updatePrice(2000)
+    ).to.be.revertedWithCustomError(oracle, "MaxChangeExceeded");
+  });
+
+  it("allows small change within maxChangeBps", async () => {
+    await oracle.connect(owner).updatePrice(1000);
+    await oracle.connect(owner).updatePrice(1040);
+    expect(await oracle.getLatestPrice()).to.equal(1040);
+  });
+
+  it("becomes stale after maxAgeSeconds", async () => {
+    await oracle.connect(owner).updatePrice(1000);
+
+    await ethers.provider.send("evm_increaseTime", [4000]);
+    await ethers.provider.send("evm_mine", []);
+
+    expect(await oracle.isStale()).to.equal(true);
+  });
+
+  it("pause blocks updates and unpause restores", async () => {
+    await oracle.connect(owner).pause();
+
+    await expect(
+      oracle.connect(owner).updatePrice(1000)
+    ).to.be.revertedWith("Pausable: paused");
+
+    await oracle.connect(owner).unpause();
+    await oracle.connect(owner).updatePrice(1000);
+    expect(await oracle.getLatestPrice()).to.equal(1000);
+  });
+});
