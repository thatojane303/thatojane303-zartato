+const { expect } = require("chai");
+const { ethers } = require("hardhat");
+
+describe("Integration: ZarTATO ↔ ZarTATOOracle", () => {
+  let owner, user;
+  let token, oracle;
+
+  beforeEach(async () => {
+    [owner, user] = await ethers.getSigners();
+
+    const Oracle = await ethers.getContractFactory("ZarTATOOracle");
+    oracle = await Oracle.deploy(owner.address, 500, 3600);
+    await oracle.waitForDeployment();
+
+    const Token = await ethers.getContractFactory("ZarTATO");
+    token = await Token.deploy(
+      await oracle.getAddress(),
+      "ZarTATO",
+      "ZTATO",
+      "South African potatoes",
+      "ZA"
+    );
+    await token.waitForDeployment();
+  });
+
+  it("token valuation responds to oracle price changes", async () => {
+    await token.connect(owner).mint(user.address, 1000n);
+
+    await oracle.connect(owner).updatePrice(1000);
+    const val1 = await token.valuation(1000n);
+
+    await oracle.connect(owner).updatePrice(2000);
+    const val2 = await token.valuation(1000n);
+
+    expect(val2).to.be.gt(val1);
+  });
+
+  it("token.latestPrice matches oracle.getLatestPrice when fresh", async () => {
+    await oracle.connect(owner).updatePrice(777);
+    const latest = await token.latestPrice();
+    expect(latest).to.equal(777);
+  });
+});
