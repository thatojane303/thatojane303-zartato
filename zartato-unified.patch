@@ -0,0 +1,112 @@
+const { expect } = require("chai");
+const { ethers } = require("hardhat");
+
+describe("ZarTATO", () => {
+  let owner, user, other;
+  let token, oracle;
+
+  beforeEach(async () => {
+    [owner, user, other] = await ethers.getSigners();
+
+    const Oracle = await ethers.getContractFactory("ZarTATOOracle");
+    oracle = await Oracle.deploy(owner.address, 500, 3600);
+    await oracle.waitForDeployment();
+
+    const Token = await ethers.getContractFactory("ZarTATO");
+    token = await Token.deploy(
+      await oracle.getAddress(),
+      "ZarTATO",
+      "ZTATO",
+      "South African potatoes",
+      "ZA"
+    );
+    await token.waitForDeployment();
+  });
+
+  it("owner can mint and user can burn", async () => {
+    await expect(token.connect(owner).mint(user.address, 1000n))
+      .to.emit(token, "Mint")
+      .withArgs(user.address, 1000n);
+
+    expect(await token.balanceOf(user.address)).to.equal(1000n);
+
+    await expect(token.connect(user).burn(400n))
+      .to.emit(token, "Burn")
+      .withArgs(user.address, 400n);
+
+    expect(await token.balanceOf(user.address)).to.equal(600n);
+  });
+
+  it("non-owner cannot mint", async () => {
+    await expect(
+      token.connect(user).mint(user.address, 1000n)
+    ).to.be.revertedWith("Ownable: caller is not the owner");
+  });
+
+  it("transfers work when not paused and not restricted", async () => {
+    await token.connect(owner).mint(user.address, 1000n);
+    await token.connect(user).transfer(other.address, 300n);
+
+    expect(await token.balanceOf(user.address)).to.equal(700n);
+    expect(await token.balanceOf(other.address)).to.equal(300n);
+  });
+
+  it("pause blocks transfers", async () => {
+    await token.connect(owner).mint(user.address, 1000n);
+    await token.connect(owner).pause();
+
+    await expect(
+      token.connect(user).transfer(other.address, 100n)
+    ).to.be.revertedWith("Pausable: paused");
+  });
+
+  it("transfer restriction blocks non-mint transfers", async () => {
+    await token.connect(owner).mint(user.address, 1000n);
+    await token.connect(owner).setTransfersRestricted(true);
+
+    await expect(
+      token.connect(user).transfer(other.address, 100n)
+    ).to.be.revertedWithCustomError(token, "TransfersBlocked");
+  });
+
+  it("latestPrice reverts when oracle is stale", async () => {
+    await oracle.connect(owner).updatePrice(1000);
+
+    await ethers.provider.send("evm_increaseTime", [4000]);
+    await ethers.provider.send("evm_mine", []);
+
+    await expect(token.latestPrice()).to.be.revertedWithCustomError(
+      token,
+      "OracleStale"
+    );
+  });
+
+  it("valuation scales with oracle price", async () => {
+    await token.connect(owner).mint(user.address, 1000n);
+
+    await oracle.connect(owner).updatePrice(1000);
+    const val1 = await token.valuation(1000n);
+
+    await oracle.connect(owner).updatePrice(1500);
+    const val2 = await token.valuation(1000n);
+
+    expect(val2).to.be.gt(val1);
+  });
+});
